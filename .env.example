# Brand shown in the navbar, footer, metadata and OG images.
# The first draft reads these from lib/site.ts; set them here if you wire
# Shopify back up later, or override per environment on GitHub.
SITE_NAME="Jeff's Carpentry"
COMPANY_NAME="Jeff's Carpentry"

# Sub-path GitHub Pages serves the repo from. Only set this in CI; keep it
# empty for `pnpm dev` so local runs are served from "/".
PAGES_SUBPATH=""

# --- Optional: Shopify storefront (not used in the first draft) ---
# When you add a live store, fill these (and GitHub secrets) and restore the
# shopifyFetch resolver in lib/shopify/index.ts from git history.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
